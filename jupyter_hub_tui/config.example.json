{
  "nodes": {
    "login": {
      "host": "login.example.org",
      "user": "youruser",
      "port": 22,
      "description": "Primary login node"
    },
    "worker-1": {
      "host": "worker-1.example.org",
      "user": "youruser",
      "port": 22,
      "description": "Compute node, access via login",
      "proxy": "login"
    },
    "worker-2": {
      "host": "worker-2.example.org",
      "user": "youruser",
      "port": 22,
      "description": "Compute node, access via login",
      "proxy": "login"
    }
  },
  "git": {
    "repo_path": "/home/youruser/repo"
  },
  "browse_path": "~",
  "venv": {
    "activate_cmd": "source ~/.bashrc && my-venv",
    "pythonpath": "/home/youruser/repo"
  }
}
