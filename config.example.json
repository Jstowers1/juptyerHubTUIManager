{
  "nodes": {
    "login": {
      "host": "login.example.org",
      "user": "youruser",
      "port": 22,
      "description": "Primary login node"
    },
    "worker-1": {
      "host": "worker-1.example.org",
      "user": "youruser",
      "port": 22,
      "description": "Compute node, access via login",
      "proxy": "login"
    },
    "worker-2": {
      "host": "worker-2.example.org",
      "user": "youruser",
      "port": 22,
      "description": "Compute node, access via login",
      "proxy": "login"
    }
  },
  "git": {
    "repo_path": "/home/youruser/icetop-cnn"
  },
  "browse_path": "~",
  "jupyter": {
    "port": 8888
  },
  "venv": {
    "activate_cmd": "source ~/.bashrc && icetop-cnn",
    "euporie_cmd": "~/.local/share/virtualenvs/icetop-cnn/bin/euporie",
    "pythonpath": "/home/youruser/icetop-cnn",
    "euporie_graphics": "none"
  }
}
